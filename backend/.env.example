# Copia este archivo como ".env" (en la carpeta backend) y ajusta lo que necesites.

PORT=3000
JWT_SECRETO=cambia-esto-por-un-texto-largo-y-secreto
BASE_DATOS=armadorpc.db

# Precios: "real" consulta tiendas de Ecuador; "demo" usa tiendas ficticias (sirve sin internet)
PRECIOS_MODO=real
PRECIOS_AUTOMATICOS=si
PRECIOS_AL_INICIAR=si
PRECIOS_ESPERA_MS=400

# AliExpress (opcional): developers.aliexpress.com + portals.aliexpress.com
ALIEXPRESS_APP_KEY=
ALIEXPRESS_APP_SECRET=
ALIEXPRESS_TRACKING_ID=

# Mercado Libre Ecuador (opcional): developers.mercadolibre.com.ec
MERCADOLIBRE_CLIENT_ID=
MERCADOLIBRE_CLIENT_SECRET=

# Solo si el frontend se publica en otro dominio
FRONTEND_ORIGEN=
